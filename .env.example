# Salin menjadi .env (atau set sebagai environment variable). JANGAN commit kunci asli.
SECRET_KEY=isi-dengan-string-acak-panjang
COOKIE_SECURE=0                 # ubah ke 1 jika situs memakai HTTPS

# Midtrans (kosongkan MIDTRANS_SERVER_KEY untuk memakai QRIS manual seperti sebelumnya)
MIDTRANS_SERVER_KEY=            # contoh sandbox: SB-Mid-server-xxxxxxxx
MIDTRANS_IS_PRODUCTION=false    # true hanya setelah akun Midtrans production disetujui
MIDTRANS_EXPIRY_MINUTES=15
